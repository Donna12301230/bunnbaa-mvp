# Stream Firestore to BigQuery: menu_items → bunnbaa_analytics.menu_items_raw_changelog (see doc/AI與GoogleCloud設計.md)
# Deploy: firebase deploy --only extensions
firebaseextensions.v1beta.function/location=asia-east1
DATASET_LOCATION=asia-east1
BIGQUERY_PROJECT_ID=bunnbaa-mvp-5474
DATABASE=(default)
DATABASE_REGION=asia-east1
COLLECTION_PATH=menu_items
WILDCARD_IDS=false
DATASET_ID=bunnbaa_analytics
TABLE_ID=menu_items
TABLE_PARTITIONING=NONE
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=no
EXCLUDE_OLD_DATA=no
# Strip personal data and payment identifiers before writing (functions/src/bigqueryExport.js)
TRANSFORM_FUNCTION=https://asia-east1-bunnbaa-mvp-5474.cloudfunctions.net/bqTransform
MAX_DISPATCHES_PER_SECOND=100
MAX_ENQUEUE_ATTEMPTS=3
LOG_LEVEL=info
