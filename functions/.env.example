# Copy this file to functions/.env and fill in your keys.
# Gemini goes through Vertex AI and authenticates with the functions service account; no API key needed
# (enable the Vertex AI API in GCP and grant the service account roles/aiplatform.user).
# Uses the global endpoint by default; to pin a region, set:
# VERTEX_LOCATION=asia-east1

# LINE Pay (consumer checkout). Sandbox channel is self-serve, no merchant
# review needed: https://pay.line.me/tw/developers -> create a Sandbox channel.
LINE_PAY_CHANNEL_ID=your_line_pay_channel_id
LINE_PAY_CHANNEL_SECRET=your_line_pay_channel_secret
# "sandbox" (default) or "production" — only switch once the real contracted-merchant
# review (blocker 3 in TODO.md) clears and you swap in the production credentials.
LINE_PAY_ENV=sandbox
# Used to build LINE Pay's confirmUrl/cancelUrl redirects back into the app.
APP_BASE_URL=https://bunnbaa-mvp-5474.web.app

# HMAC signing key for pickup QR codes (phase 1 spec §6.2). Production must set a long random string,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PICKUP_QR_SECRET=change_me_to_a_long_random_string
# Disaster data source (§11); defaults to the NCDR (National Science and Technology Center for Disaster Reduction) CAP Atom feed, rarely needs changing
# DISASTER_FEED_BASE=https://alerts.ncdr.nat.gov.tw/RssAtomFeed.ashx?AlertType=

# For the local emulator you can also create functions/.env.local (not in git) with GEMINI_DISABLED=1 and LINE_PAY_* left blank,
# so triggers don't call Gemini en masse and run up costs while seeding data.
