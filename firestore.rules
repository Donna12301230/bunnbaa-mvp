rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin backend auth: no Cloud Functions custom claims yet (blocked on
    // Blaze upgrade), so admin access is a plain email allowlist checked
    // straight off the Firebase Auth token. Keep this in sync by hand with
    // ADMIN_EMAILS in web/src/lib/adminAuth.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['suw192336@gmail.com'];
    }

    // vendors: publicly readable (browsing); writes via admin backend only for MVP
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // locks: consumer creates their own lock; read is public (needed to show live availability)
    match /locks/{lockId} {
      allow read: if true;
      allow create: if request.resource.data.buyer_uid == request.auth.uid;
      // status transitions (resell, fulfilled, no_show) are normally done via
      // Cloud Functions with admin rights; admin backend can also override
      // directly since those Functions aren't deployed to prod yet (Blaze).
      allow update: if (request.auth != null && resource.data.buyer_uid == request.auth.uid
                    && request.resource.data.status == 'for_resale')
                    || isAdmin();
      allow delete: if false;
    }

    // accuracy_reports: written only by Cloud Functions (admin SDK bypasses rules), readable by anyone
    // for MVP transparency; scope to vendor-authenticated reads if this goes beyond the pilot.
    match /accuracy_reports/{reportId} {
      allow read: if true;
      allow write: if false;
    }

    // discount_explanations cache: written only by Cloud Functions, publicly readable
    match /discount_explanations/{cacheKey} {
      allow read: if true;
      allow write: if false;
    }

    // payouts: written only by settleVendorPayouts (Cloud Function), publicly
    // readable for MVP transparency, same as accuracy_reports.
    match /payouts/{payoutId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
