rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin backend auth: no Cloud Functions custom claims yet (blocked on
    // Blaze upgrade), so admin access is a plain email allowlist checked
    // straight off the Firebase Auth token. Keep this in sync by hand with
    // ADMIN_EMAILS in web/src/lib/adminAuth.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['suw192336@gmail.com', 'ckchildlikekid@gmail.com'];
    }

    // Consumers must log in with a real account to lock, resell, gift or claim
    // meals (2026-09-24: anonymous sign-in is no longer used). Also reused for
    // users/ and vendor_applications/ so an anonymous token can't create either.
    function isSignedInUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Repeated no-shows set users/{uid}.orderBanned (written server-side by
    // markLockOutcome). Missing field/doc = not banned, so this never blocks
    // someone who's never had a users/ doc written for them.
    function isBanned() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orderBanned', false) == true;
    }

    // A lock changing hands must append its previous owner to
    // transferred_from_uids (arrayUnion semantics: existing entries kept, at
    // most one added), so 「我的轉讓」 can still find it after buyer_uid moves on.
    function recordsPreviousOwner() {
      let before = resource.data.get('transferred_from_uids', []);
      let after = request.resource.data.get('transferred_from_uids', []);
      return after is list
        && after.hasAll(before)
        && resource.data.buyer_uid in after
        && after.size() <= before.size() + 1;
    }

    // vendors: publicly readable (browsing); writes via admin backend only for MVP
    match /vendors/{vendorId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // 合作方案改成每份餐點抽成（2026-10-05），沒有月費訂閱，店主不再有訂閱欄位可以自助改。
      allow update: if isAdmin()
                    // Store profile + pickup schedule from the vendor portal's settings
                    // page. Name stays admin-only (it's what buyers trust/recognise).
                    // Element formats are checked again server-side at checkout
                    // (functions/src/pricing.js); rules only bound types and sizes.
                    || (isVendorOwner(vendorId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['description', 'address', 'phone', 'pickup_windows',
                                       'business_hours', 'holidays', 'slot_capacity', 'cover_image',
                                       'description_en', 'i18n_src',
                                       // 第一階段規格 §2「店家可調」：截單只能提前、安全庫存、候選菜成立最低量；
                                       // 取餐點座標（區域洞察、附近愛心餐）、新店家自填預估、異常週
                                       'cutoff_time', 'safety_stock_rate', 'candidate_min_qty', 'lat', 'lng',
                                       'forecast_daily', 'anomaly_weeks',
                                       // 菜單目錄（目錄 > 分類 兩層）的名稱與順序
                                       'menu_catalogs'])
                        && request.resource.data.get('menu_catalogs', []) is list
                        && request.resource.data.get('menu_catalogs', []).size() <= 30
                        && (!request.resource.data.keys().hasAny(['cutoff_time'])
                            || (request.resource.data.cutoff_time is string
                                && request.resource.data.cutoff_time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                                && request.resource.data.cutoff_time <= '20:00'))
                        && (!request.resource.data.keys().hasAny(['safety_stock_rate'])
                            || (request.resource.data.safety_stock_rate is number
                                && request.resource.data.safety_stock_rate >= 0
                                && request.resource.data.safety_stock_rate <= 1))
                        && (!request.resource.data.keys().hasAny(['candidate_min_qty'])
                            || (request.resource.data.candidate_min_qty is int
                                && request.resource.data.candidate_min_qty >= 1
                                && request.resource.data.candidate_min_qty <= 500))
                        && request.resource.data.get('description', '') is string
                        && request.resource.data.get('description', '').size() <= 500
                        && request.resource.data.get('address', '') is string
                        && request.resource.data.get('address', '').size() <= 200
                        && request.resource.data.get('phone', '') is string
                        && request.resource.data.get('phone', '').size() <= 30
                        && request.resource.data.get('pickup_windows', []) is list
                        && request.resource.data.get('pickup_windows', []).size() <= 12
                        && request.resource.data.get('business_hours', []) is list
                        && request.resource.data.get('business_hours', []).size() <= 7
                        && request.resource.data.get('holidays', []) is list
                        && request.resource.data.get('holidays', []).size() <= 100
                        && request.resource.data.get('slot_capacity', 0) is int
                        && request.resource.data.get('slot_capacity', 0) >= 0
                        && request.resource.data.get('slot_capacity', 0) <= 10000
                        // Firebase Storage download URL from ImageUploadField; https only so it
                        // can't carry a javascript:/data: URL into the storefront <img>.
                        && request.resource.data.get('cover_image', '') is string
                        && request.resource.data.get('cover_image', '').size() <= 500
                        && request.resource.data.get('cover_image', '').matches('^$|^https://.*')
                        // 手動修改的英文簡介（其餘英文由 Functions translateVendor 自動翻）；
                        // i18n_src 只能動 description——店名的英文跟店名一樣只有管理員／自動翻譯能改
                        && request.resource.data.get('description_en', '') is string
                        && request.resource.data.get('description_en', '').size() <= 1000
                        && request.resource.data.get('i18n_src', {}).get('name', null)
                             == resource.data.get('i18n_src', {}).get('name', null));
    }

    // Booked meals per vendor + pickup date + window (capacity), written only
    // by confirmLinePayPayment. Public read so the pickup picker can show
    // "剩 N 份" — it holds counts only, no buyer data.
    match /slot_counters/{counterId} {
      allow read: if true;
      allow write: if false;
    }

    // locks: consumer creates their own lock. Reads are limited (ISO 27001
    // A.5.34 — buyer_uid is a registered account's uid since 2026-09-24, so a
    // public read would let anyone link one person's whole order history):
    // only listings currently up for resale/gift are public (the transfer
    // market + gift links need them; list queries must filter on status so
    // the rule can prove it), otherwise the buyer, that vendor's owner
    // (redeem/prep pages), or an admin.
    match /locks/{lockId} {
      allow read: if resource.data.status in ['for_resale', 'for_gift']
                  || (request.auth != null && resource.data.buyer_uid == request.auth.uid)
                  // Previous owners keep read access so 「我的轉讓」 can show what
                  // happened to a lock after someone else took it over.
                  || (request.auth != null && request.auth.uid in resource.data.get('transferred_from_uids', []))
                  || isAdmin()
                  || isVendorOwner(resource.data.vendor_id);
      // Locks are only created by confirmLinePayPayment (Admin SDK, bypasses
      // rules) after LINE Pay captures the money. The last client-side path,
      // HomePage's plan-join, moved to createPlanLinePayReservation on
      // 2026-09-28 — until then a client could mint unpaid locks here. Bans
      // are enforced server-side by assertNotBanned.
      allow create: if false;
      // status transitions (fulfilled, no_show) are normally done via Cloud
      // Functions with admin rights; admin backend can also override directly
      // since those Functions aren't deployed to prod yet (Blaze). Everything
      // below this comment is deliberately expressed as a plain client-side
      // rule instead of a Cloud Function, so it works today without waiting
      // on the Blaze upgrade (TODO.md 卡點 1).
      allow update: if isAdmin()
                    // Buyer flips their own still-"locked" lock to "for_resale",
                    // optionally attaching a resale_deadline (pickup-window-based,
                    // bounded so it can't be back-dated or set absurdly far out — 31 days
                    // covers the farthest bookable pickup window (bookingRangeDays=30);
                    // once it's past, anyone may free-claim, see below).
                    || (isSignedInUser() && resource.data.buyer_uid == request.auth.uid
                        && resource.data.status == 'locked'
                        && request.resource.data.status == 'for_resale'
                        // 轉讓人自訂轉讓價（2026-10-05）：0 ～ 原價（品項原價＋加減項，不含早鳥折扣），
                        // 不能加價賣；伺服器 resalePriceOf 會再夾一次。沒填就用早鳥價。
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resale_deadline', 'resale_price'])
                        && (!request.resource.data.keys().hasAny(['resale_price'])
                            || (request.resource.data.resale_price is int
                                && request.resource.data.resale_price >= 0
                                && request.resource.data.resale_price
                                     <= resource.data.get('list_price', resource.data.locked_price) + resource.data.get('adjust_amount', 0)))
                        && (!request.resource.data.keys().hasAny(['resale_deadline'])
                            || (request.resource.data.resale_deadline is timestamp
                                && request.resource.data.resale_deadline > request.time
                                && request.resource.data.resale_deadline <= request.time + duration.value(31, 'd'))))
                    // Buyer privately gifts their own still-"locked" lock — not
                    // publicly listed anywhere, the recipient needs the lock_id/link
                    // itself (same trust model as handing someone the pickup QR code).
                    || (isSignedInUser() && resource.data.buyer_uid == request.auth.uid
                        && resource.data.status == 'locked'
                        && request.resource.data.status == 'for_gift'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                    // Named friend claims a gifted lock — any signed-in user other
                    // than the giver, since "naming" happens out-of-band (whoever
                    // the giver shares the link/lock_id with).
                    || (isSignedInUser() && resource.data.status == 'for_gift'
                        && request.auth.uid != resource.data.buyer_uid
                        && request.resource.data.status == 'locked'
                        && request.resource.data.buyer_uid == request.auth.uid
                        && recordsPreviousOwner()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyer_uid', 'transferred_from_uids', 'share_token']))
                    // Buyer cancels their own still-unclaimed for_resale/for_gift
                    // listing back to locked (TODO.md 2026-09-22 待辦：取消轉讓
                    // 沒有對應規則). Only reachable while buyer_uid is still theirs —
                    // once someone else claims it, buyer_uid has already moved on.
                    // 有人正在付款接手（resale_hold 未過期）時，賣家不能再取消，否則會跟接手交易打架
                    || (isSignedInUser() && resource.data.buyer_uid == request.auth.uid
                        && resource.data.status in ['for_resale', 'for_gift']
                        && !(resource.data.get('resale_hold', null) != null && resource.data.resale_hold.expires_at > request.time)
                        && request.resource.data.status == 'locked'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resale_deadline', 'resale_price']))
                    // Anyone claims an expired resale listing for free — replaces a
                    // scheduled "release" Cloud Function with a lazy, rule-enforced
                    // expiry checked at claim time.
                    || (isSignedInUser() && resource.data.status == 'for_resale'
                        && resource.data.get('resale_deadline', null) != null
                        && resource.data.resale_deadline < request.time
                        && request.resource.data.status == 'locked'
                        && request.resource.data.buyer_uid == request.auth.uid
                        && request.resource.data.locked_price == 0
                        && recordsPreviousOwner()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyer_uid', 'locked_price', 'transferred_from_uids', 'share_token']))
                    // Buyer leaves feedback once the lock is settled — one-shot (the
                    // field must not already exist) so it can't be edited after the
                    // fact; this feeds vendor calibration (functions/src/index.js
                    // buildVendorHistory), so it shouldn't be revisable.
                    || (isSignedInUser() && resource.data.buyer_uid == request.auth.uid
                        // charity：第一階段未取餐／主動捐出都轉成愛心餐（MyBookingsPage FEEDBACK_ELIGIBLE）
                        && resource.data.status in ['fulfilled', 'resold_and_fulfilled', 'no_show', 'charity']
                        && !resource.data.keys().hasAny(['consumer_feedback'])
                        && request.resource.data.consumer_feedback is string
                        && request.resource.data.consumer_feedback.size() > 0
                        && request.resource.data.consumer_feedback.size() <= 280
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumer_feedback']));
      allow delete: if false;
    }

    // lock_tokens: FCM device tokens for pickup reminders, kept off the public
    // locks docs. Known gap: only Cloud Functions (admin SDK) can delete/replace
    // one, so after a gift/free-claim/resale handoff the previous buyer's stale
    // token is left in place instead of being handed to the new buyer — same
    // gap claimResoldLock used to have (it now deletes the token). Harmless for now since reminders are
    // dormant pending VAPID key + Blaze deploy (TODO.md 卡點 1). The buyer creates
    // one for a lock they own; only that buyer or
    // an admin can read it; Cloud Functions (admin SDK) manage the rest.
    match /lock_tokens/{lockId} {
      allow create: if isSignedInUser()
                    && request.resource.data.keys().hasOnly(['fcm_token', 'buyer_uid'])
                    && request.resource.data.fcm_token is string
                    && request.resource.data.fcm_token.size() < 4096
                    && request.resource.data.buyer_uid == request.auth.uid
                    && get(/databases/$(database)/documents/locks/$(lockId)).data.buyer_uid == request.auth.uid;
      allow read: if (isSignedInUser() && resource.data.buyer_uid == request.auth.uid) || isAdmin();
      allow update, delete: if false;
    }

    // admin_audit_logs: append-only record of admin overrides (ISO 27001 A.8.15).
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.admin_email == request.auth.token.email;
      allow update, delete: if false;
    }

    // A vendor's owner is the Firebase Auth account whose uid an admin stored in
    // vendors/{id}.owner_uid. Payout and calibration data is business-confidential
    // (ISO 27001 A.5.34), so only that owner or an admin may read it.
    function isVendorOwner(vendorId) {
      return request.auth != null
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.get('owner_uid', null) == request.auth.uid;
    }

    // accuracy_reports: written only by Cloud Functions (admin SDK bypasses rules)
    match /accuracy_reports/{reportId} {
      allow read: if isAdmin() || isVendorOwner(resource.data.vendor_id);
      allow write: if false;
    }

    // discount_explanations cache: written only by Cloud Functions, publicly readable
    match /discount_explanations/{cacheKey} {
      allow read: if true;
      allow write: if false;
    }

    // payouts: written only by settleVendorPayouts (Cloud Function)
    match /payouts/{payoutId} {
      allow read: if isAdmin() || isVendorOwner(resource.data.vendor_id);
      allow write: if false;
    }

    // growth_rewards: 0 元券庫存、已解鎖門檻（unlocked_milestones）等狀態，只有
    // Cloud Functions（drawGrowthReward／syncGrowthUnlock，admin SDK 略過規則）能寫。
    // 公開可讀——商家後台跟消費者端都要讀，內容只有門檻 id 不含金額，公開沒有隱私問題。
    match /growth_rewards/{vendorId} {
      allow read: if true;
      allow write: if false;
    }

    // reviews/{lockId}: 消費者對已取餐的一筆鎖定打 1–5 星（可附公開心得），一筆鎖定
    // 只能評一次（doc id＝lock id，create 不能覆寫既有文件，也沒有 update）。公開可讀：
    // 計畫方案平均分數、Landing 同學評價都讀這裡；不存 buyer_uid，reviewer_label 是
    // 前端組的「系所＋同學」。vendor_id／meal_plan_id／item_name 必須跟那筆 lock 一致。
    function reviewableLock(lockId) {
      let lock = get(/databases/$(database)/documents/locks/$(lockId)).data;
      return lock.buyer_uid == request.auth.uid
        && lock.status in ['fulfilled', 'resold_and_fulfilled']
        && request.resource.data.vendor_id == lock.vendor_id
        && request.resource.data.meal_plan_id == lock.get('meal_plan_id', null)
        && request.resource.data.item_name == lock.item_name;
    }
    match /reviews/{lockId} {
      allow read: if true;
      allow create: if isSignedInUser()
                    && request.resource.data.keys().hasOnly(['vendor_id', 'meal_plan_id', 'item_name', 'rating', 'comment', 'reviewer_label', 'created_at'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 280
                    && request.resource.data.reviewer_label is string
                    && request.resource.data.reviewer_label.size() <= 30
                    && request.resource.data.created_at == request.time
                    && reviewableLock(lockId);
      allow delete: if isAdmin();
    }

    // platform_config: 平台層級設定（成長獎勵門檻 growth、Landing 活動卡片以外的
    // 固定參數）。公開可讀，前端和 Functions 讀同一份；只有管理員能改。
    match /platform_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // landing_events: Landing 頁「近期活動」卡片，公開可讀、只有管理員能改。
    match /landing_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // draws: 開獎紀錄，同樣只由 drawGrowthReward 寫。公開可讀，理由同上——內容只有
    // buyer_tag（uid 末 6 碼，2026-09-24 起不再存完整 buyer_uid）／折數／品項，沒有個資或金額。
    match /draws/{drawId} {
      allow read: if true;
      allow write: if false;
    }

    // payment_intents: LINE Pay reserve/confirm bookkeeping (amount, LINE Pay
    // transaction_id, draft lock fields). Only createLinePayReservation /
    // confirmLinePayPayment (admin SDK, bypasses rules) ever touch this —
    // the client only ever sees the order_id/payment_url they return.
    match /payment_intents/{orderId} {
      allow read, write: if false;
    }

    // menu_items: real catalog backing VendorPage/MenuItemPage/CartPage
    // (replaces the old mockMenuItems). Publicly readable for browsing;
    // writes restricted to admin or that item's own vendor owner. The
    // update rule pins vendor_id so an owner can't relabel their own item
    // onto a different vendor's storefront.
    match /menu_items/{itemId} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth != null && isVendorOwner(request.resource.data.vendor_id));
      allow update: if isAdmin() || (request.auth != null
                      && isVendorOwner(resource.data.vendor_id)
                      && request.resource.data.vendor_id == resource.data.vendor_id);
      allow delete: if isAdmin() || (request.auth != null && isVendorOwner(resource.data.vendor_id));
    }

    // meal_plans: real multi-day subscription plan catalog backing
    // HomePage.tsx's "合作店家與計畫" cards (replaces mockVendorMealPlans).
    // Same read/write shape as menu_items — public catalog, vendor-owner or
    // admin writes.
    match /meal_plans/{planId} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth != null && isVendorOwner(request.resource.data.vendor_id));
      allow update: if isAdmin() || (request.auth != null
                      && isVendorOwner(resource.data.vendor_id)
                      && request.resource.data.vendor_id == resource.data.vendor_id);
      allow delete: if isAdmin() || (request.auth != null && isVendorOwner(resource.data.vendor_id));
    }

    // ban_appeals: a banned user files one for themselves (status must start
    // "pending"); only an admin decides it. Approving one also resets the
    // user's ban (users/{uid} rule below), done client-side as a batch in
    // AdminAppealsPage.tsx.
    match /ban_appeals/{appealId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.buyer_uid == request.auth.uid);
      allow create: if isSignedInUser() && isBanned()
                    && request.resource.data.buyer_uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(
                         ['buyer_uid', 'username', 'display_name', 'reason', 'status', 'created_at']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // users/{uid}: platform profile written at registration (web/src/lib/auth.ts).
    // Deliberately holds no role — admin comes from the email allowlist and
    // vendor from vendors/{id}.owner_uid, so nothing here can grant access.
    // orderBanned/noPickupCount are set server-side by markLockOutcome (admin
    // SDK bypasses rules); the isAdmin() branch below is only for resetting
    // them when an appeal is approved.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      // lang：介面語言（zh／en），取餐提醒推播依這個決定用哪種語言
      allow create: if isSignedInUser() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                         ['display_name', 'phone', 'school', 'department', 'created_at', 'lang',
                          'muted_kinds', 'device_id', 'home_geo', 'charity_nearby_push'])
                    && request.resource.data.get('lang', 'zh') in ['zh', 'en'];
      // diff().affectedKeys(), not the whole document's keys() — otherwise once
      // orderBanned/noPickupCount exist on a doc (any past ban), the owner could
      // never touch their own profile fields again, since the resulting document
      // would always carry keys outside this allowlist.
      // muted_kinds：關掉哪些通知（例如愛心餐通知）；device_id：異常偵測（同裝置多帳號）；
      // home_geo：常用地點，只存粗略 geohash（約 150 公尺，§14.2），不存定位軌跡
      allow update: if isSignedInUser() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ['display_name', 'phone', 'school', 'department', 'created_at', 'lang',
                          'muted_kinds', 'device_id', 'home_geo', 'charity_nearby_push'])
                    && request.resource.data.get('home_geo', '').size() <= 7
                    && request.resource.data.get('lang', 'zh') in ['zh', 'en'];
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderBanned', 'noPickupCount']);
      allow delete: if false;
    }

    // vendor_applications/{uid}: the applicant files one for themselves (status
    // must start "pending"); only an admin decides it. Approval itself binds
    // vendors/{id}.owner_uid, which admins can already write.
    match /vendor_applications/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if isSignedInUser() && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(
                         ['store_name', 'phone', 'email', 'status', 'created_at']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── 第一階段規格（doc/BunnBaa 飯飽｜第一階段技術規格.md §12）──────────────
    // 抽獎、兌現、開池、截單、退款一律由 Cloud Functions（admin SDK）寫入。

    // 平台全域參數、菜色庫、定式模板：公開可讀，只有管理員能改
    match /platformConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /dishLibrary/{dishId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 店家的配方與採購資料是營業機密（ISO 27001 A.5.34）：只有店主與管理員能讀寫。
    // 叫貨單、備料計畫、回饋期別、許願統計由 Functions 產生，店主只能勾選備料完成（done）。
    match /vendors/{vendorId}/{sub}/{docId} {
      allow read: if isAdmin() || isVendorOwner(vendorId);
      allow write: if (isAdmin() || isVendorOwner(vendorId))
                   && sub in ['ingredients', 'components', 'suppliers', 'inventory'];
      allow update: if isVendorOwner(vendorId) && sub == 'prepPlans'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
    }

    // 候選菜許願計數（「地瓜葉 7/10」），只有數字不含個資，公開可讀
    match /sideWishes/{id} {
      allow read: if true;
      allow write: if false;
    }
    // 開放許願：本人可讀自己的；店家只看 wishTally 彙總
    match /openWishes/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    // 成長獎勵：公開進度（不含金額）、本人的消費累計／抽獎券／折價券
    match /rewardStatus/{vendorId} {
      allow read: if true;
      allow write: if false;
    }
    match /userSpend/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }
    match /rewardTickets/{id} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.user_id == request.auth.uid)
                  || isVendorOwner(resource.data.vendor_id);
      allow write: if false;
    }
    match /coupons/{id} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.get('user_id', null) == request.auth.uid)
                  || isVendorOwner(resource.data.vendor_id);
      allow write: if false;
    }

    // 我的最愛（§4.5）：收藏的店家，僅本人可讀寫；也是口味偏好的正面訊號
    match /users/{uid}/favorites/{vendorId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if isSignedInUser() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['vendor_id', 'created_at'])
                    && request.resource.data.vendor_id == vendorId
                    && request.resource.data.created_at == request.time;
      allow update: if false;
    }

    // 口味偏好：僅本人可讀；本人只能寫主動設定（prefs）與過敏（allergies），分數由後端算
    match /tasteProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if isSignedInUser() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['prefs', 'allergies'])
                    && request.resource.data.get('prefs', {}) is map
                    && request.resource.data.get('allergies', []) is list
                    && request.resource.data.get('allergies', []).size() <= 20;
      allow update: if isSignedInUser() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefs', 'allergies'])
                    && request.resource.data.get('prefs', {}) is map
                    && request.resource.data.get('allergies', []) is list
                    && request.resource.data.get('allergies', []).size() <= 20;
    }
    // 區域洞察：只含彙總，只給該店店主
    match /areaInsights/{id} {
      allow read: if isAdmin() || isVendorOwner(resource.data.vendor_id);
      allow write: if false;
    }

    // 愛心餐：公開清單不含個資；預約紀錄本人可讀，店家不能讀個人欄位（§12）
    match /charityMeals/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /charityReservations/{id} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }
    match /charityBans/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 天災事件：公開可讀（前台顯示「可能因颱風取消」），管理員可手動建立（資料來源失效時的備援）
    match /disasterEvents/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /anomalies/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note']);
      allow create, delete: if false;
    }

    // 站內通知：本人可讀、只能標成已讀
    match /notifications/{id} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null && resource.data.user_id == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
    // AI 功能（doc/AI功能設計.md）：只有 Functions 讀寫
    // menu_embeddings：品項向量（轉讓媒合用），不給前端讀，品項頁不用多載向量
    // resale_matches：轉讓媒合通知了誰、是否由被通知的人接手（影響指標），管理員可讀
    // assistant_cache：預購助理單輪問答快取
    match /menu_embeddings/{id} {
      allow read, write: if false;
    }
    match /resale_matches/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /assistant_cache/{id} {
      allow read, write: if false;
    }
    // 推播 token（每人最多保留 5 個裝置）
    match /userTokens/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if isSignedInUser() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['tokens'])
                            && request.resource.data.tokens is list
                            && request.resource.data.tokens.size() <= 5;
    }
  }
}
