# Copy to .env.local for local development.

# Point the app at the local Firebase emulators instead of production.
VITE_USE_EMULATORS=true

# Only needed once a vendor menu-editing form uses ImageUploadField.
# Create an unsigned upload preset in your Cloudinary dashboard first.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
