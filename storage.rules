rules_version = '2';

// 店家封面圖、菜單品項圖（web/src/components/ImageUploadField.tsx）。
// 公開可讀（店家頁/菜單頁要顯示）；只有該店店主或管理員能寫入，
// 店主身分以 Firestore vendors/{vendorId}.owner_uid 為準（跨服務規則）。
service firebase.storage {
  match /b/{bucket}/o {

    // Keep in sync with isAdmin() in firestore.rules / ADMIN_EMAILS in web/src/lib/adminAuth.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['suw192336@gmail.com', 'ckchildlikekid@gmail.com'];
    }

    function isVendorOwner(vendorId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.get('owner_uid', null) == request.auth.uid;
    }

    match /vendors/{vendorId}/{fileName} {
      allow read: if true;
      allow create, update: if (isVendorOwner(vendorId) || isAdmin())
                            && request.resource.size <= 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isVendorOwner(vendorId) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
